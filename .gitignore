# =====================================================================
# Liste blanche : tout est ignore, sauf les dossiers envoyes sur GitHub
#   arbiochem-ejb/src, arbiochem-war/src, arbiochem-war/web, data, instruction, TEST
# =====================================================================

# 1. Tout ignorer a la racine...
/*

# 2. ...sauf ces dossiers et ce fichier
!/.gitignore
!/arbiochem-ejb/
!/arbiochem-war/
!/data/
!/instruction/
!/TEST/

# 3. Dans les modules, seulement les sources
/arbiochem-ejb/*
!/arbiochem-ejb/src/

/arbiochem-war/*
!/arbiochem-war/src/
!/arbiochem-war/web/

# Vraie base de l'entreprise (clients reels) : jamais sur GitHub.
# Les scripts du cinema (data/cinema/) sont envoyes.
/data/REAL DATA/

# 4. Fichiers inutiles ou generes, ou qu'ils soient
*.iml
.DS_Store
Thumbs.db
*.class
*.war
*.log
