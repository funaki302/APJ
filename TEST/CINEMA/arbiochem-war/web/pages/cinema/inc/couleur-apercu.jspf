<%-- Remplace le texte d'une couleur #RRGGBB par une pastille + le code, dans les tableaux et fiches du cinema --%>
<script>
    (function () {
        var cellules = document.querySelectorAll('.content-wrapper td, .content-wrapper dd, .content-wrapper span');
        for (var i = 0; i < cellules.length; i++) {
            var td = cellules[i];
            var texte = td.textContent.trim();
            if (td.children.length === 0 && /^#[0-9A-Fa-f]{6}$/.test(texte)) {
                td.innerHTML = '<span style="display:inline-block;width:16px;height:16px;border-radius:4px;border:1px solid #999;vertical-align:middle;margin-right:6px;background:'
                        + texte + '"></span>' + texte;
            }
        }
    })();
</script>
